rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Workbench technical lab diagnostics & user authentication rules
    match /wb_users/{userId} {
      allow read, write: if true;
    }
    match /wb_audit_logs/{logId} {
      allow read, write: if true;
    }
    match /wb_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}
